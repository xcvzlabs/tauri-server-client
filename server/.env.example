SERVER_HOST="0.0.0.0"
SERVER_PORT="8080"

# SQLite connection string. The file (and its parent directory) is created
# automatically on first run.
DATABASE_URL="sqlite://./data/server.sqlite"

# HS256 signing secret for access tokens. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-value-at-least-32-characters-long"

ACCESS_TOKEN_TTL_MINUTES="15"
REFRESH_TOKEN_TTL_DAYS="7"

# Comma-separated list of allowed CORS origins, e.g. "http://localhost:1420,tauri://localhost".
# Leave empty during local LAN development to allow any origin.
ALLOWED_ORIGINS=""
