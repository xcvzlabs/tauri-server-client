{
  "name": "tauri-server-client",
  "description": "LAN-based client-server desktop application built with Tauri and Rust",
  "version": "0.0.2",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "tauri build",
    "lint-staged": "lint-staged",
    "fmt": "bun run oxc:fmt && bun run tauri:fmt && bun run server:fmt",
    "fmt:check": "bun run oxc:fmt:check && bun run tauri:fmt:check && bun run server:fmt:check",
    "lint": "bun run oxc:lint && bun run tauri:lint && bun run server:lint",
    "prepare": "husky",
    "test": "bun run test:vitest && bun run test:cargo",
    "test:vitest": "vitest run",
    "test:cargo": "cargo test --manifest-path server/Cargo.toml",
    "release": "bun run scripts/release.ts",
    "oxc:fmt": "oxfmt",
    "oxc:fmt:check": "oxfmt --check",
    "oxc:lint": "oxlint",
    "tauri:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "tauri:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "tauri:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "server:dev": "cd server && cargo run",
    "server:seed": "cd server && cargo run --bin seed",
    "server:build": "cargo build --manifest-path server/Cargo.toml --release",
    "server:fmt": "cargo fmt --manifest-path server/Cargo.toml",
    "server:fmt:check": "cargo fmt --manifest-path server/Cargo.toml -- --check",
    "server:lint": "cargo clippy --manifest-path server/Cargo.toml --all-targets -- -D warnings",
    "postinstall": "nuxt prepare",
    "nuxt:build": "nuxt build",
    "nuxt:dev": "nuxt dev",
    "nuxt:generate": "nuxt generate",
    "nuxt:preview": "nuxt preview",
    "nuxt:typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@formisch/vue": "^1.0.0",
    "@lucide/vue": "^1.41.0",
    "@nuxt/fonts": "^0.14.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "~2",
    "@tauri-apps/plugin-store": "^2",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.4",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@golar/vue": "^0.1.10",
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.4.1",
    "changelogen": "^0.6.2",
    "consola": "^3.4.2",
    "golar": "^0.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "shadcn-nuxt": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.3.14"
}
