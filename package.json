{
  "name": "tauri-server-client",
  "description": "LAN-based client-server desktop application built with Tauri and Rust",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "tauri build",
    "lint-staged": "lint-staged",
    "fmt": "bun run oxc:fmt && bun run cargo:fmt && bun run server:fmt",
    "fmt:check": "bun run oxc:fmt:check && bun run cargo:fmt:check && bun run server:fmt:check",
    "lint": "bun run oxc:lint && bun run cargo:lint && bun run server:lint",
    "prepare": "husky",
    "test": "bun run test:vitest && bun run test:cargo",
    "test:vitest": "vitest run",
    "test:cargo": "cargo test --manifest-path server/Cargo.toml",
    "release": "bun run scripts/release.ts",
    "oxc:fmt": "oxfmt",
    "oxc:fmt:check": "oxfmt --check",
    "oxc:lint": "oxlint",
    "cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "cargo:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "cargo:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "server:dev": "cargo run --manifest-path server/Cargo.toml",
    "server:build": "cargo build --manifest-path server/Cargo.toml --release",
    "server:fmt": "cargo fmt --manifest-path server/Cargo.toml",
    "server:fmt:check": "cargo fmt --manifest-path server/Cargo.toml -- --check",
    "server:lint": "cargo clippy --manifest-path server/Cargo.toml --all-targets -- -D warnings",
    "postinstall": "nuxt prepare",
    "nuxt:build": "nuxt build",
    "nuxt:dev": "nuxt dev",
    "nuxt:generate": "nuxt generate",
    "nuxt:preview": "nuxt preview",
    "nuxt:typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-store": "^2",
    "nuxt": "^4.5.2",
    "valibot": "^1.4.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@golar/vue": "^0.1.10",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "changelogen": "^0.6.2",
    "consola": "^3.4.2",
    "golar": "^0.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
